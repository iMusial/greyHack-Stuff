//                                "command, flag, and param discovery"
checkParams = function(x)
params = x.split(" ")
//for item in matches, do this
//single command check
if isCommand(params[0], true) == false then return print("unkown command: " + params[0])

count = 0
flags = []
subparams = []
allSubParams = []

//check every parameter for a command or flags
for i in params
		//print("checking: " + params[count])
		allSubParams.push(params[count]) //add param to a list of every single param provided

		if params[count] == params[0] then
			//print("command set: " + params[0])  //detect and set the current command
			command = params[0]
	end if

        if params[count].indexOf("-") == 0 then
              //  print("flag detected!")         //detect and add the flag to a list of flags
                flags.push(params[count])

		else if params[count] != params[0] then
		subparams.push(params[count])          //detect and add the  param to a list of params
		//print("subparam detected!")
	end if

        //get the index of the detected flag, then add subsequent parameters into a list of 'subparameters' for the flag
        //check if its a real flag, or treat it as a parameter
        count = count + 1
end for
//print(char(10) + "command: " + params[0])
//print("list of detected flags: " + flags)
//print("list of detected subparams: " + subparams)
//print("list of everything: " + allSubParams)
isCommand(params[0], false, allSubParams)


//now check the index of the flag and use sequential indexes as their parameter until the next flag
end function



