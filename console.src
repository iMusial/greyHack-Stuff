while continyou == true

queryScan = user_input("connect> ")

if queryScan == "y" or queryScan == "yes" or queryScan == "ye" or queryScan == "Y" then
	return scanlib(ip)
	continyou = false
	//                                         come back ehre asdakslj fhaskjd fhaskljdfhaks jdhfksajl
	else
	if queryScan == "n" or queryScan == "no" or queryScan == "na" or queryScan == "N" then return print("connect: cancelled, returning to console")
	print("bad answer, try again.")
end if
end while
end function

scanIt = function(params)
if params.len == 1 then return help("scan")
if params.len != 2 then return print("scan: invalid syntax")

pingStatus = get_shell.ping(params[1])

if pingStatus == 1 then
	return print("Host is online!")
	else
	if pingStatus != 0 then return print(pingStatus)
end if


end function

nmap = function(params)
print("todo: detect remote connection or home computer" + char(10))
if params.len == 1 then return help("nmap")
if params.len != 2 then return print("nmap: invalid syntax")
ip = params[1]
isLanIp = is_lan_ip(ip)
isValid = is_valid_ip(ip)

if isValid == 0 then return print("nmap: invalid IP address")
if isValid == 1 then
	//if ipAddress == "127.0.0.1" then ipAddress = get_shell.host_computer.local_ip
	if isLanIp then
   router = get_router;
else
   router = get_router(ip)
end if

if router == null then return print("nmap: ip address not found")
ports = null

if not isLanIp then
   ports = router.used_ports
else
   ports = router.device_ports(ip)
end if

if ports == null then return print("nmap: ip address not found")
if typeof(ports) == "string" then return print(ports)

info = "PORT STATE SERVICE VERSION LAN"
print("\nStarting nmap v1.1 at " + current_date)
print("Interesting ports on " + params[1] + "\n")
if(ports.len == 0) then return print("Scan finished. No open ports.")

for port in ports
   service_info = router.port_info(port)
   lan_ips = port.get_lan_ip
   port_status = "open"

   if(port.is_closed and not isLanIp) then
      port_status = "closed"
   end if
   info = info + "\n" + port.port_number + " " + port_status + " " + service_info + " " + lan_ips
end for
print(format_columns(info) + "\n")

//check for a remote connection?
//if remoteConnection != true then print("home computer")

end function

