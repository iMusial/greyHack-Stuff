rshell_interface = function()
print("Listening for upcoming connections...")

shells = []
while shells.len == 0
	shells = metaxploit.rshell_server
	if(typeof(shells) == "string") then exit(shells)
	if(shells.len == 0) then wait(2)
end while

option = 0
while typeof(option) != "number" or (option < 1 or option > shells.len)
	print(shells.len + " shell(s) connected!\n<b>Select a shell to start a terminal:</b>")
	for i in range(0, shells.len - 1)
		print("\n<b>Shell (" + (i + 1) + ")</b>\nPublic IP: " + shells[i].host_computer.public_ip + "\nLocal IP: " + shells[i].host_computer.local_ip)
	end for
	print("-----------")
	option = user_input("Select shell>").to_int
end while
print("Starting shell #" + option)
shells[option - 1].start_terminal
print("welcome back!")
end function


connect = function(params)
print("todo: connect" + char(10))
if params.len == 1 then return help("connect")
if params.len != 2 then return print("connect: invalid syntax")

//scanrouter
ip = params[1]
isValid = is_valid_ip(ip)
if isValid == 0 then return print("connect: invalid IP address")

router = get_router(ip)
if router == null then return print("connect: ip address not found")
if router then
	print("Connected to router at " + ip)
	print(char(10) + "\   |   /")
	print("_\__|__/_ ")
	print("| . . . |")
	print("|_______|" + char(10))
version = router.kernel_version
if not version then
	print("Warning: kernel_router.so not found")
else
	print("kernel_router.so version : v" + version)
end if

firewall_rules = router.firewall_rules
if typeof(firewall_rules) == "string" then return print(firewall_rules)
if firewall_rules.len == 0 then print("No firewall rules found.")
info = "ACTION PORT SOURCE_IP DESTINATION_IP"
if firewall_rules.len != 0 then
for rules in firewall_rules
	info = info + "\n" + rules
end for
print(format_columns(info) + "\n")
end if

print("Scan remote host for vulnerabilities? y/n")
//ask to scan remote host, reprompt when given a bas answer
