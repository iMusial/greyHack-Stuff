isCommand = function(x, ischeck, params)
//                                "the yandaredev section"
//if isCommand is detected as just a command check, it will simply do as the name suggests and NOT run the program erm
itIsCommand = false
if ischeck == true then
	if x == "?" or x == "help" then return true
if x == "exit" then itIsCommand = true
if x == "cat" then itIsCommand = true
if x == "pwd" then itIsCommand = true
if x == "download" then itIsCommand = true
if x == "upload" then itIsCommand = true
if x == "search" or x == "find" then itIsCommand = true
if x == "hashdump" then itIsCommand = true
if x == "reboot" or x == "shutdown" then itIsCommand = true
if x == "rshell" then itIsCommand = true
if x == "cd" then itIsCommand = true
if x == "curl ifconfig.me" or x == "ifconfig" then itIsCommand = true
if x == "systeminfo" then itIsCommand = true
if x == "portfwd" then itIsCommand = true
if x == "sysinfo" then itIsCommand = true
if x == "getuid" or x == "whoami" then itIsCommand = true
if x == "getsystem" or x == "getroot" then itIsCommand = true
if x == "nmap" then itIsCommand = true
if x == "clear" then itIsCommand = true
if x == "recon" then itIsCommand = true
if x == "whois" then itIsCommand = true
if x == "ssh" then itIsCommand = true
if x == "scan" then itIsCommand = true
if x == "connect" then itIsCommand = true
if x == "rshells" then itIsCommand = false
if itIsCommand == true then return true
end if

if x == "?" or x == "help" then return help(x)
if x == "exit" then return exit()
if x == "cat" then return concat()
if x == "pwd" then return pwd()
if x == "download" then return scpd()
if x == "upload" then return scpu()
if x == "search" or x == "find" then return find()
if x == "hashdump" then return hashdump()
if x == "reboot" or x == "shutdown" then return shutdown()
if x == "rshell" then return startRshellServ()
if x == "cd" then return currentd()
if x == "curl ifconfig.me" or x == "ifconfig" then return ifconfig()
if x == "systeminfo" then systeminfo()
if x == "portfwd" then return portfwd()
if x == "sysinfo" then return sysinfo()
if x == "getuid" or x == "whoami" then return whoami()
if x == "getsystem" or x == "getroot" then return getsystem()
if x == "nmap" then return nmap(params)
if x == "scan" then return scanIt(params)
if x == "recon" then return recon()
if x == "whois" then return whodat()
if x == "ssh" then return ssh()
if x == "rshells" then return rshell_interface()
if x == "connect" then return connect(params)
//god help us all
if x == "clear" then
return clear()
else
return false
end if

end function

