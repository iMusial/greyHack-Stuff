scanlib = function(ip)

//prompt for port num
print("connect: enter a port number")

continyou = true

while continyou == true
port = user_input("connect> ").to_int
if typeof(port) == "number" then
	continyou = false
	else
	if typeof(port) != "number" then print("bad answer, try again.")
end if
end while


net_session = metaxploit.net_use(ip, port)		// connects to provided IP address using metaxploit lib
	// if connection is not established prints red text and exits
print("Scanning")		// this will print text on screen
metaLib = net_session.dump_lib		// this will set ver metaLib to get to the connected library
//INFO
//workflow
//get a list of addresses
//for every address in that list, scan that address for insecure values, extract the values, and test them along with the address

scanResult = metaxploit.scan(metaLib) //ADDRESSES
spot = 0
valSpot = 0
scanInfo = null
segments = null
exploit = null
vulnVals = []
sploits = []
x= 0
for address in scanResult

	addr = scanResult[spot] //address is set
	scanInfo = metaxploit.scan_address(metaLib, addr)//string of INFO, using addr as the mem zone
	segments = scanInfo.split("Unsafe check: ") //uhhh... yea
	exploit = null

	for segment in segments

    	labelStart = segment.indexOf("<b>") //every vuln is bolded, this marks the beginning infex of the vuln val
    	labelEnd = segment.indexOf("</b>") //every vuln has a remove bold tag, this marks the end of the vuln val

   		exploit = segment[labelStart + 3: labelEnd] //extracted vuln val
		vulnVals.push(exploit)// add the extracted vuln val to a list

end for

	killMe = vulnVals[0]
	vulnVals.remove(killMe)
	//print(char(10) + "discovered insecure values: " + vulnVals + char(10) + "testing exploits in memory zone: " + addr)
	for val in vulnVals
		result = metaLib.overflow(addr, vulnVals[valSpot])
		//add exploit type detection for file, computer, shell    //////////////////////////////////////////////// RESULT DETECTION //////////////////////
		print("obtained: " + typeof(result))
		typaResult = typeof(result)
		isrouter = false
		if typaResult == "number" and result != 1 then
			if port == 0 then isrouter = true

			if isrouter == true then
				while x == 0
				query = user_input("enter a lan address: ")
				if is_valid_ip(query) == true then x = x + 1
				if is_valid_ip(query) == false then print("bad address, try again")
				end while
				result = metaLib.overflow(addr, vulnVals[valSpot], query)
				//if its a computer or file then print it or add it
			if typeof(result) == "computer" then
			sploits.push(result)
			end if
		end if
				if isrouter == false then
				query = user_input("overwrite password to '123'? y/n")
				if query == "y" then
				result = metaLib.overflow(addr, vulnVals[valspot], "123")
				else if query == "n" then
				print("password injection aborted")
			end if
			end if
			//lan ip
			//save result details for later use?
			else

				//new password

			end if
		if typaResult == "shell" then
			sploits.push(result)
	end if



			if typaResult == "file" then
			//identify folder or file, then get contents
			if is_folder(result) == true then
				print("directory accessed: " + result.path)
				files_in_dir = result.get_files
				print(files_in_dir.len)
				for file in files_in_dir
					print(file.name + ":: " + file.get_content)
		end for
		else
		print("file obtained, printing name and contents")
		print(result.get_name + ":: " + file.get_content)
			end if
		end if
			if typaResult == "computer" then
			print("computer added to list")
			sploits.push(result)
			print(sploits)
		end if                                                      ////////////////////////////////// END RESULT DETECTION, CONTINUE //////////////////////
		valSpot = valSpot + 1
	end for
spot = spot + 1
vulnVals = [] //a NEW list of vulmnerable values is created, its flushed so previous mem zone exclusive vulns arent repeated
valSpot = 0
end for
count = 0
for sploit in sploits
	print("[" + count + "] " + sploits[count])
	count = count + 1
end for

cont = true
while cont == true
x = user_input("what woyd you like to do: ").to_int
if typeof(x) != "number" then
	print("bad response, try again. " + char(10) + "q to return to console")
else 
cont = false
end if
if x == "q" then return
end while



exploit = sploits[x]
if typeof(exploit) == "shell" then// identify shell exploit
	exploit.start_terminal()
	print("yello")
	net_session = null
	return console()
end if
if typeof(exploit) == "file" then //identifty fiile exploit then print contents or the name of the folder. I'll do folder contents later... probably
	print(exploit.get_content)
	print("file printed")
	else
	if typeof(exploit) == "folder" then print(sploits[x].name)
end if

if typeof(exploit) == "computer" then // identify computer exploit then print passwords for system and mails

	print("searching for creds...")
	passwdFile = exploit.File("/etc/passwd")
	print(passwdFile.get_content)

	homedir = exploit.File("/home")
	print("found mails: ")
	for file in homedir.get_folders
		mailFile = exploit.File("/home/" + file.name + "/Config/Mail.txt")
		if file.name == "guest" then
		query = user_input("guest config folder obtained, are you sure you want to continue? (program will probably crash) y/n: ")
		if query == "y" then print(mailFile.get_content)
		if query == "n" then return("process aborted")
		end if
		print(mailFile.get_content)
	end for

end if


end function
