//begin checking libraries


//                            /////////////////////////           MAIN           //////////////////////////
missingLibs = []  //initiating the list of missing libraries

metaxploit = include_lib("/lib/metaxploit.so")  //check if metaxploit is in it's default location
if not metaxploit then metaxploit = include_lib(current_path + "/metaxploit.so") //if metaxploit isn't in /lib check if it is in the current directory
if not metaxploit then missingLibs.push("metaxploit.so") //add metaxploit to the list of missing libs

crypto = include_lib("/lib/crypto.so")  //check if crypto is in it's default location
if not crypto then crypto = include_lib(current_path + "/crypto.so") //if crypto isn't in /lib check if it is in the current directory
        if not crypto then missingLibs.push("crypto.so") //add crypto to the list of missing libs

if not crypto or not metaxploit then
        print("[X] required libraries not found in current directory or /lib!")
spot = 0
for i in missingLibs
        print("[i] missing: " + missingLibs[spot])
        spot = spot + 1
end for
exit()
end if

