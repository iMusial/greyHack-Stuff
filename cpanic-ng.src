home = get_shell.host_computer

//loading config file and libs, if no config file then create one
init = function()

	clear_screen
	
	crypto = include_lib(current_path+"crypto.so")
	if not crypto then crypto = include_lib("/lib/crypto.so")
	if not crypto then print("[!] dependency crypto.so not found current directory or /lib")
	
	meta = include_lib(current_path+"metaxploit.so")
	if not meta then meta = include_lib("/lib/metaxploit.so")
	if not meta then print("[!] dependency metaxploit.so not found in current directory or /lib")
		
end function

//define functions
help = function()
	print("cpanic help page:\n")
    print("scan\nadds an IP to your NetMap, issues an ICMP echo ping")
    print("\nconnect\nSets a target IP and connects to the NetMap if not already added")
	print("\nprobe\nCommon port scanning")
    print("\ndisconnect\nunsets current target from an earlier 'connect' command")
    print("\nanalyze\nscans all 65,536 ports and service versions, best used before analyze")
    print("\nsolve\nrequires analyze to be run first, recommends an attack vector by checking service versions for CVEs, and other misconfigurations like anonymous ftp logins or overly-verbose responses")
    print("\nclear\nclears the terminal")
    print("\nnote\nusage: note [add,rm,edit, list] <filename>\nlets the user quickly add a note located in /home/documents/cpanicNotes")
    print("\nsave\n saves current session data like nmap scans, analyze outputs, and target info to a text document that can be used to resume the engagement\n")
end function

//list commands in /bin and use launch rather than scripting every single one
commandHandler = function(preParsedCmd)

commandsList=["help", "scan", "exit"] //list of valid commands with functions
separatedAwaitingParsing = preParsedCmd.split(" ") //separates the users blob into a list by spaces " "
cmd = separatedAwaitingParsing[0] //grabs the first index of the split user blob

validCommand = false
for command in commandsList
	if cmd == command then validCommand = true
end for

test={"help":help()}
test.cmd

if not validCommand then print("unknown command: " + cmd)

end function

//the "shell"
init()

while true
preParsedCmd = user_input(">")
commandHandler(preParsedCmd)
end while
